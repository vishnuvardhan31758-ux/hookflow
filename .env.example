# HookFlow Configuration
NODE_ENV=development
PORT=3000

# Webhook Ingestion Secret (HMAC-SHA256)
HOOKFLOW_DEFAULT_SECRET=sec_wh_production_live_key_998877

# Optional: Neon Cloud PostgreSQL (Runs built-in resilient in-memory/edge store if unset)
# DATABASE_URL="postgresql://user:password@ep-cool-lake-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Optional: Upstash Redis (Runs built-in distributed token-bucket if unset)
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Max Retries for Dead-Letter Queue
HOOKFLOW_MAX_RETRIES=5
